# Optional public URL of the read-only Stripe catalog service.
# Stripe API keys belong in the backend's AWS Secrets Manager secret, never in VITE_*.
VITE_STRIPE_CATALOG_URL=

# Local development only. Opens the synthetic fixture at /__stripe-preview.
# Keep disabled for normal work; the fixture is excluded from production builds.
VITE_STRIPE_DEMO=0

# Optional sandbox Payment Link for verifying an AWS test catalog in the local preview.
VITE_STRIPE_PREVIEW_PAYMENT_LINK=
